include("${REFERENCE}")
execute_process(COMMAND "${HOST}" --self-test RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 12)
message("${errors}${output}")
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "TinyX startup/self-test failed: ${result}")
endif()
set(depth "${EXPECTED_DEPTH_${PIXEL_BITS}}")
set(masks "${EXPECTED_MASKS_${PIXEL_BITS}}")
if(NOT errors MATCHES "root ${WIDTH}x${HEIGHT} depth=${depth} visuals=${EXPECTED_VISUAL_COUNT} ")
    message(FATAL_ERROR "Native geometry/depth/visual count differs from reference")
endif()
if(NOT errors MATCHES "visual class=${EXPECTED_VISUAL_CLASS} depth-bits=8 masks=${masks}")
    message(FATAL_ERROR "Visual class/masks differ from reference")
endif()
string(REGEX MATCHALL "extension [^ \n]+ opcode=[0-9]+" entries "${errors}")
set(actual)
foreach(entry IN LISTS entries)
    string(REGEX REPLACE "extension ([^ ]+) opcode=.*" "\\1" name "${entry}")
    list(APPEND actual "${name}")
endforeach()
list(SORT actual)
list(SORT EXPECTED_EXTENSIONS)
if(NOT "${actual}" STREQUAL "${EXPECTED_EXTENSIONS}")
    message(FATAL_ERROR "Registered extensions differ from reference: ${actual}")
endif()
if(NOT output MATCHES "P4: root=valid.*PASS")
    message(FATAL_ERROR "Root rendering/CPU/polling measurements did not pass")
endif()
