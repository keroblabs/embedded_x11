+      if(*cursor) *cursor++ = 0;
+   }
+   app = count ? wmb_app_lookup(arguments[0]) : NULL;
+   if(!app) Warning("application is not registered: %s", command);
+   else {
+      task = wmb_app_launch(app, count, arguments);
