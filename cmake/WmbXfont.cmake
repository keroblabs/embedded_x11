include(FetchContent)
if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.24)
    set(timestamp_option DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
endif()
if(WMB_FREESTANDING OR WMB_USE_BUNDLED_FLOOR)
    include("${CMAKE_CURRENT_LIST_DIR}/WmbZlib.cmake")
else()
    find_package(ZLIB REQUIRED)
endif()

FetchContent_Declare(wmb_xfont_source
    URL https://www.x.org/releases/individual/lib/libXfont-1.5.4.tar.bz2
    URL_HASH SHA256=1a7f7490774c87f2052d146d1e0e64518d32e6848184a18654e8d0bb57883242
    ${timestamp_option}
)
FetchContent_MakeAvailable(wmb_xfont_source)
set(XFONT_ROOT "${wmb_xfont_source_SOURCE_DIR}")
include("${CMAKE_CURRENT_LIST_DIR}/WmbDependencyPatch.cmake")
foreach(patch_name empty-directory pcf-unsigned-reads builtins-only allocation)
    set(font_patch "${WMB_SOURCE_ROOT}/cmake/patches/libxfont-1.5.4-${patch_name}.patch")
    wmb_apply_dependency_patch("${XFONT_ROOT}" "${font_patch}")
endforeach()
set(XFONT_SOURCES)
set(selected_xfont_sources "tinyx/os/fonts_wmb.c")
foreach(group fontfile bitmap builtins util)
    if(group STREQUAL fontfile)
        set(names bitsource bufio defaults fontdir fontfile fontscale gunzip renderers)
    elseif(group STREQUAL bitmap)
        set(names bitmap bitmaputil bitscale fontink pcfread pcfwrite)
    elseif(group STREQUAL builtins)
        set(names dir file fonts fpe render)
    else()
        set(names atom fontaccel fontnames fontutil fontxlfd format miscutil
            patcache private utilbitmap)
    endif()
    foreach(name IN LISTS names)
        list(APPEND XFONT_SOURCES "${XFONT_ROOT}/src/${group}/${name}.c")
        list(APPEND selected_xfont_sources "libXfont/src/${group}/${name}.c")
    endforeach()
endforeach()
list(SORT selected_xfont_sources)
file(STRINGS "${WMB_SOURCE_ROOT}/docs/reference/xfont-sources.reference"
    reference_xfont_sources REGEX "^[^#]")
if(NOT "${selected_xfont_sources}" STREQUAL "${reference_xfont_sources}")
    message(FATAL_ERROR "Font source cohort differs from docs/reference/xfont-sources.reference")
endif()
configure_file("${WMB_SOURCE_ROOT}/cmake/xfont-config.h.in"
    "${CMAKE_BINARY_DIR}/generated/xfont/config.h" @ONLY)
add_library(wmb_xfont STATIC ${XFONT_SOURCES} "${TINYX_SOURCE_ROOT}/os/fonts_wmb.c")
target_include_directories(wmb_xfont PUBLIC "${XFONT_ROOT}/include" PRIVATE
    "${CMAKE_BINARY_DIR}/generated/xfont" "${XFONT_ROOT}/src/bitmap"
    "${XFONT_ROOT}/src/builtins" "${XFONT_ROOT}/src/stubs" "${WMB_SOURCE_ROOT}")
target_compile_definitions(wmb_xfont PRIVATE HAVE_CONFIG_H=1)
target_include_directories(wmb_xfont PRIVATE "${TINYX_SOURCE_ROOT}/include")
target_link_libraries(wmb_xfont PUBLIC ZLIB::ZLIB)
