set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
find_program(CMAKE_C_COMPILER NAMES arm-none-eabi-gcc)
foreach(tool AR RANLIB NM OBJDUMP OBJCOPY)
    string(TOLOWER "${tool}" program)
    find_program(CMAKE_${tool} NAMES "arm-none-eabi-${program}")
    if(NOT CMAKE_${tool})
        message(FATAL_ERROR "The P9a toolchain requires arm-none-eabi-${program}")
    endif()
endforeach()
find_program(WMB_READELF NAMES arm-none-eabi-readelf)
find_program(WMB_SIZE NAMES arm-none-eabi-size)
if(NOT CMAKE_C_COMPILER OR NOT WMB_READELF OR NOT WMB_SIZE)
    message(FATAL_ERROR "Install an Arm bare-metal GCC/binutils toolchain before configuring P9a")
endif()
execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-sysroot
    OUTPUT_VARIABLE compiler_root OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE root_result)
if(NOT root_result EQUAL 0)
    message(FATAL_ERROR "The ARM compiler could not report its sysroot")
endif()
set(CMAKE_FIND_ROOT_PATH "${compiler_root}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-m3 -mthumb -mfloat-abi=soft -ffreestanding -fno-builtin -fno-pic -fno-pie -fno-common -fno-stack-protector -ffunction-sections -fdata-sections")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-nostdlib -static -Wl,--build-id=none -Wl,--no-undefined")
