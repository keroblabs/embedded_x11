#define XVENDORNAME "WMB"
#define VENDOR_STRING "WMB"
#define VENDOR_RELEASE 1
#define OSNAME "WMB HAL"
#define DPMSExtension 1
#define RES 1
#define XResExtension 1
#define SCREENSAVER 1
#define SMART_SCHEDULE 1
