/* Smart-scheduler layout is retained; WMB OsInit disables its signal timer. */
/* No native transports/processes, hardware mapper, or SHM. */
/* XKB/DBE/XF86BIGFONT must be undefined: upstream tests presence, not value. */

#if defined(__GNUC__) && !defined(_X_UNUSED)
#define _X_UNUSED __attribute__((unused))
#else
#define _X_UNUSED
#endif

#endif
